# Supabase Environment Variables
# Copy this file to .env.local and fill in your real Supabase project credentials

# Supabase Project URL (from: Supabase Dashboard → Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (from: Supabase Dashboard → Project Settings → API → anon public)
# This is safe to use in browser — it enforces Row Level Security
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ⚠️ NEVER add SUPABASE_SERVICE_ROLE_KEY here — service role keys bypass RLS
# ⚠️ NEVER add DATABASE_PASSWORD here — keep all privileged credentials server-side only
